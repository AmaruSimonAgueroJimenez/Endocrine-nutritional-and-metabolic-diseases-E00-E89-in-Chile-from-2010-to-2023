        "\n",
        "## Geospatial Analysis — Municipal-level ASR"
      ],
      "id": "c14006ba"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: geospatial-calc\n",
        "#| include: false\n",
        "\n",
        "from esda.moran import Moran_Local\n",
        "from matplotlib.patches import Patch\n",
        "import io, contextlib\n",
        "\n",
        "# ICD_COLORS already defined in constants block\n",
        "ICD_CMAPS = {\n",
        "    'E00-E07': 'Reds', 'E08-E13': 'Blues', 'E15-E16': 'Greens',\n",
        "    'E20-E35': 'Purples', 'E36': 'Oranges', 'E40-E46': 'YlOrBr',\n",
        "    'E50-E64': 'RdPu', 'E65-E68': 'Greys', 'E70-E88': 'BuGn',\n",
        "    'E89': 'OrRd',\n",
        "}\n",
        "\n",
        "# --- Compute mean ASR by comuna (total) ---\n",
        "who_weights_df = pd.DataFrame([{'age_group': k, 'who_weight': v} for k, v in WHO_STANDARD_POPULATION.items()])\n",
        "\n",
        "comuna_asr = pd.DataFrame()\n",
        "if 'comuna' in pop_data.columns:\n",
        "    hosp_comuna = hosp_5year.groupby(['comuna', 'age_group']).agg({'hospitalizations': 'sum'}).reset_index()\n",
        "    pop_comuna = pop_data.groupby(['comuna', 'age_group'])['population'].sum().reset_index()\n",
        "    merged_c = hosp_comuna.merge(pop_comuna, on=['comuna', 'age_group'], how='left')\n",
        "    merged_c = merged_c.dropna(subset=['population'])\n",
        "    merged_c = merged_c[merged_c['population'] > 0]\n",
        "    merged_c['age_specific_rate'] = (merged_c['hospitalizations'] / merged_c['population']) * 100000\n",
        "    merged_c = merged_c.merge(who_weights_df, on='age_group', how='left')\n",
        "    merged_c['weighted_rate'] = merged_c['age_specific_rate'] * merged_c['who_weight']\n",
        "    comuna_asr = merged_c.groupby('comuna').agg({'weighted_rate': 'sum', 'hospitalizations': 'sum'}).reset_index()\n",
        "    comuna_asr['asr'] = (comuna_asr['weighted_rate'] / TOTAL_WHO_WEIGHT).round(2)\n",
        "    comuna_asr = comuna_asr.sort_values('asr', ascending=False)\n",
        "\n",
        "# --- Compute mean ASR by comuna per ICD category ---\n",
        "comuna_asr_by_icd = {}\n",
        "if 'comuna' in pop_data.columns:\n",
        "    for icd_cat in icd_summary['icd_category'].tolist():\n",
        "        hosp_icd_com = hosp_5year[hosp_5year['icd_category'] == icd_cat].groupby(\n",
        "            ['comuna', 'age_group']).agg({'hospitalizations': 'sum'}).reset_index()\n",
        "        m = hosp_icd_com.merge(pop_comuna, on=['comuna', 'age_group'], how='left')\n",
        "        m = m.dropna(subset=['population'])\n",
        "        m = m[m['population'] > 0]\n",
        "        m['age_specific_rate'] = (m['hospitalizations'] / m['population']) * 100000\n",
        "        m = m.merge(who_weights_df, on='age_group', how='left')\n",
        "        m['weighted_rate'] = m['age_specific_rate'] * m['who_weight']\n",
        "        asr_s = m.groupby('comuna').agg({'weighted_rate': 'sum', 'hospitalizations': 'sum'}).reset_index()\n",
        "        asr_s['asr'] = (asr_s['weighted_rate'] / TOTAL_WHO_WEIGHT).round(2)\n",
        "        if asr_s['asr'].sum() > 0:\n",
        "            comuna_asr_by_icd[icd_cat] = asr_s\n",
        "\n",
        "# --- Excluded comunas (islands / Antarctica) ---\n",
        "def is_excluded_comuna(name):\n",
        "    if pd.isna(name):\n",
        "        return True\n",
        "    s = str(name).upper()\n",
        "    excluded = ['ISLA DE PASCUA', 'JUAN FERNANDEZ', 'ANTARTICA', 'CABO DE HORNOS', 'ANTARTICA CHILENA']\n",
        "    return any(e in s for e in excluded)\n",
        "\n",
        "# --- Normalize comuna name for matching ---\n",
        "def normalize_comuna_spatial(x):\n",
        "    if pd.isna(x):\n",
        "        return None\n",
        "    s = str(x).upper().strip()\n",
        "    repl = {'Á': 'A', 'É': 'E', 'Í': 'I', 'Ó': 'O', 'Ú': 'U', 'Ñ': 'N'}\n",
        "    for old, new in repl.items():\n",
        "        s = s.replace(old, new)\n",
        "    s = ''.join(c for c in s if c.isalnum() or c == ' ')\n",
        "    return s.strip()\n",
        "\n",
        "# --- Load shapefile and build spatial GeoDataFrames ---\n",
        "has_spatial_data = False\n",
        "gdf_chile = None\n",
        "gdf_continental = None\n",
        "gdf_total = None\n",
        "pesos = None\n",
        "COMUNA_COL = None\n",
        "REGION_CODE_COL = None\n",
        "\n",
        "shp_candidates = [\n",
        "    str(comunas_shp),\n",
        "    str(data_base / 'shapefiles' / 'division_comunal.shp'),\n",
        "    str(data_base / 'comunas_chile.shp'),\n",
        "]\n",
        "shp_path = None\n",
        "for candidate in shp_candidates:\n",
        "    if os.path.exists(candidate):\n",
        "        shp_path = candidate\n",
        "        break\n",
        "\n",
        "if shp_path:\n",
        "    gdf_chile = gpd.read_file(shp_path)\n",
        "\n",
        "    for col in ['Comuna', 'COMUNA', 'NOM_COMUNA', 'nom_comuna', 'NAME', 'NOM_COM']:\n",
        "        if col in gdf_chile.columns:\n",
        "            COMUNA_COL = col\n",
        "            break\n",
        "    if COMUNA_COL is None:\n",
        "        COMUNA_COL = gdf_chile.columns[0]\n",
        "\n",
        "    for col in ['codregion', 'CODREGION', 'COD_REGION', 'Region', 'REGION']:\n",
        "        if col in gdf_chile.columns:\n",
        "            REGION_CODE_COL = col\n",
        "            break\n",
        "\n",
        "    gdf_chile['comuna_norm'] = gdf_chile[COMUNA_COL].apply(normalize_comuna_spatial)\n",
        "\n",
        "    if REGION_CODE_COL:\n",
        "        gdf_chile[REGION_CODE_COL] = pd.to_numeric(gdf_chile[REGION_CODE_COL], errors='coerce')\n",
        "\n",
        "    gdf_continental = gdf_chile[~gdf_chile[COMUNA_COL].apply(is_excluded_comuna)].copy()\n",
        "\n",
        "    # Merge total ASR\n",
        "    if not comuna_asr.empty:\n",
        "        ca_copy = comuna_asr.copy()\n",
        "        ca_copy['comuna_norm'] = ca_copy['comuna'].apply(normalize_comuna_spatial)\n",
        "        gdf_total = gdf_continental.merge(\n",
        "            ca_copy[['comuna_norm', 'asr']], on='comuna_norm', how='left'\n",
        "        ).rename(columns={'asr': 'asr_total'})\n",
        "        gdf_total['asr_total'] = gdf_total['asr_total'].fillna(0)\n",
        "        has_spatial_data = True\n",
        "\n",
        "        # Build spatial weights (suppress island warnings)\n",
        "        buf = io.StringIO()\n",
        "        with contextlib.redirect_stdout(buf):\n",
        "            try:\n",
        "                pesos = Queen.from_dataframe(gdf_total, silence_warnings=True)\n",
        "            except TypeError:\n",
        "                pesos = Queen.from_dataframe(gdf_total)\n",
        "\n",
        "    # Merge per-ICD category ASR\n",
        "    gdf_by_icd = {}\n",
        "    for icd_cat, asr_s in comuna_asr_by_icd.items():\n",
        "        asr_s_copy = asr_s.copy()\n",
        "        asr_s_copy['comuna_norm'] = asr_s_copy['comuna'].apply(normalize_comuna_spatial)\n",
        "        gdf_s = gdf_continental.merge(\n",
        "            asr_s_copy[['comuna_norm', 'asr']], on='comuna_norm', how='left'\n",
        "        )\n",
        "        gdf_s['asr'] = gdf_s['asr'].fillna(0)\n",
        "        if gdf_s['asr'].sum() > 0:\n",
        "            gdf_by_icd[icd_cat] = gdf_s"
      ],
      "id": "geospatial-calc",
      "execution_count": null,
      "outputs": []
