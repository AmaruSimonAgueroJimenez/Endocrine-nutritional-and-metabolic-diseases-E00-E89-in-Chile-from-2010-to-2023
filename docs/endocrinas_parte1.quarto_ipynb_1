      "source": [
        "#| label: lisa-calculation\n",
        "#| include: false\n",
        "\n",
        "def classify_lisa(lisa_obj, data):\n",
        "    sig = lisa_obj.p_sim < 0.05\n",
        "    q = lisa_obj.q\n",
        "    labels = ['Not Significant'] * len(data)\n",
        "    for i in range(len(data)):\n",
        "        if sig[i]:\n",
        "            if q[i] == 1:\n",
        "                labels[i] = 'High-High (Hot Spot)'\n",
        "            elif q[i] == 2:\n",
        "                labels[i] = 'Low-High'\n",
        "            elif q[i] == 3:\n",
        "                labels[i] = 'Low-Low (Cold Spot)'\n",
        "            elif q[i] == 4:\n",
        "                labels[i] = 'High-Low'\n",
        "    return labels\n",
        "\n",
        "lisa_total = None\n",
        "lisa_by_icd = {}\n",
        "\n",
        "if has_spatial_data and pesos is not None:\n",
        "    if gdf_total['asr_total'].var() > 0:\n",
        "        try:\n",
        "            lisa_total = Moran_Local(gdf_total['asr_total'], pesos)\n",
        "            gdf_total['cluster'] = classify_lisa(lisa_total, gdf_total)\n",
        "            gdf_total['lisa_p'] = lisa_total.p_sim\n",
        "        except:\n",
        "            gdf_total['cluster'] = 'No data'\n",
        "            gdf_total['lisa_p'] = 1.0\n",
        "    else:\n",
        "        gdf_total['cluster'] = 'Sin datos'\n",
        "\n",
        "    for icd_cat in gdf_by_icd:\n",
        "        gdf = gdf_by_icd[icd_cat]\n",
        "        if gdf['asr'].var() > 0:\n",
        "            try:\n",
        "                lisa_s = Moran_Local(gdf['asr'], pesos)\n",
        "                gdf_by_icd[icd_cat]['cluster'] = classify_lisa(lisa_s, gdf)\n",
        "                gdf_by_icd[icd_cat]['lisa_p'] = lisa_s.p_sim\n",
        "                lisa_by_icd[icd_cat] = lisa_s\n",
        "            except:\n",
        "                gdf_by_icd[icd_cat]['cluster'] = 'Sin datos'"
      ],
