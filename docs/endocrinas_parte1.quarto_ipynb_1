      "source": [
        "#| label: fig-sex-ratio-by-icd\n",
        "#| fig-cap: M:F Sex Ratio of ASR by ICD Category — Endocrine Diseases (Latest Year)\n",
        "\n",
        "# Compute sex-specific ASR by ICD category for the latest year\n",
        "hosp_sex_icd = hosp_5year.groupby(['year', 'age_group', 'sex', 'icd_category']).agg(\n",
        "    {'hospitalizations': 'sum'}).reset_index()\n",
        "who_weights = pd.DataFrame([{'age_group': k, 'who_weight': v} for k, v in WHO_STANDARD_POPULATION.items()])\n",
        "\n",
        "icd_sex_list = []\n",
        "for icd_cat in icd_summary['icd_category'].tolist():\n",
        "    for sex in ['Male', 'Female']:\n",
        "        icd_sex_data = hosp_sex_icd[\n",
        "            (hosp_sex_icd['year'] == latest_year) &\n",
        "            (hosp_sex_icd['icd_category'] == icd_cat) &\n",
        "            (hosp_sex_icd['sex'] == sex)\n",
        "        ]\n",
        "        sex_pop = pop_data[(pop_data['year'] == latest_year) & (pop_data['sex'] == sex)]\n",
        "        sex_pop_agg = sex_pop.groupby('age_group')['population'].sum().reset_index()\n",
        "        merged = icd_sex_data.merge(sex_pop_agg, on='age_group', how='left')\n",
        "        merged = merged[merged['population'] > 0].dropna(subset=['population'])\n",
        "        merged['age_specific_rate'] = (merged['hospitalizations'] / merged['population']) * 100000\n",
        "        merged = merged.merge(who_weights, on='age_group', how='left')\n",
        "        merged['weighted_rate'] = merged['age_specific_rate'] * merged['who_weight']\n",
        "        asr_val = merged['weighted_rate'].sum() / TOTAL_WHO_WEIGHT\n",
        "        icd_sex_list.append({'icd_category': icd_cat, 'sex': sex, 'asr': round(asr_val, 2)})\n",
        "\n",
        "icd_sex_df = pd.DataFrame(icd_sex_list)\n",
        "icd_sex_pivot = icd_sex_df.pivot(index='icd_category', columns='sex', values='asr').fillna(0)\n",
        "icd_sex_pivot['ratio'] = (icd_sex_pivot['Male'] / icd_sex_pivot['Female'].replace(0, np.nan)).round(2)\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 8))\n",
        "\n",
        "ax1 = axes[0]\n",
        "x = np.arange(len(icd_sex_pivot))\n",
        "width = 0.35\n",
        "ax1.barh(x - width/2, icd_sex_pivot['Male'], width, label='Males', color='steelblue')\n",
        "ax1.barh(x + width/2, icd_sex_pivot['Female'], width, label='Females', color='coral')\n",
        "ax1.set_yticks(x)\n",
        "ax1.set_yticklabels([f'{s}: {ICD10_MAPPING.get(s, s)[:20]}' for s in icd_sex_pivot.index], fontsize=9)\n",
        "ax1.set_xlabel('ASR (per 100,000)')\n",
        "ax1.set_title(f'ASR by Sex and Category — {int(latest_year)}', fontweight='bold')\n",
        "ax1.legend()\n",
        "ax1.grid(axis='x', alpha=0.3)\n",
        "\n",
        "ax2 = axes[1]\n",
        "ratio_sorted = icd_sex_pivot.sort_values('ratio', ascending=True)\n",
        "colors_ratio = ['coral' if r < 1 else 'steelblue' for r in ratio_sorted['ratio']]\n",
        "ax2.barh([f'{s}: {ICD10_MAPPING.get(s, s)[:20]}' for s in ratio_sorted.index],\n",
        "         ratio_sorted['ratio'], color=colors_ratio)\n",
        "ax2.axvline(x=1, color='gray', linestyle='--', linewidth=2)\n",
        "ax2.set_xlabel('Sex Ratio M:F of ASR')\n",
        "ax2.set_title('Sex Ratio by ICD Category', fontweight='bold')\n",
        "ax2.grid(axis='x', alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "save_figure(fig, 'sex_ratio_by_icd_endocrinas.png')\n",
        "plt.show()"
