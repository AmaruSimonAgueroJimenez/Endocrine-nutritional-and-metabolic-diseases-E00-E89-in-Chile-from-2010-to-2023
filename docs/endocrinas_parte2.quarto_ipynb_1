        "# Función para normalizar fechas (maneja formatos diferentes)\n",
        "def parse_date_flexible(date_str, year=None):\n",
        "    \"\"\"\n",
        "    Parsea fechas que pueden estar en formato DD-MM-YYYY o YYYY-MM-DD\n",
        "    \"\"\"\n",
        "    if pd.isna(date_str) or date_str == '':\n",
        "        return pd.NaT\n",
        "\n",
        "    if isinstance(date_str, (int, float)):\n",
        "        return pd.NaT\n",
        "\n",
        "    date_str = str(date_str).strip()\n",
        "\n",
        "    # Para 2023: DD-MM-YYYY; para otros: YYYY-MM-DD\n",
        "    if year == 2023:\n",
        "        for fmt in [\"%d-%m-%Y\", \"%Y-%m-%d\", \"%d/%m/%Y\", \"%Y/%m/%d\"]:\n",
        "            try:\n",
