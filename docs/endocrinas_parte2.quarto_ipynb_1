        "# Table 10B: Difference in Comorbidity Prevalence (Deceased - Discharged) with chi-square\n",
        "comorb_diff = []\n",
        "for cat in sorted(df_endocrinas['endocrine_category'].dropna().unique()):\n",
        "    df_cat = df_endocrinas[df_endocrinas['endocrine_category'] == cat]\n",
        "    row = {'Disease Category': cat}\n",
        "\n",
        "    for col in comor_cols:\n",
        "        df_dis = df_cat[df_cat['mortality'] == 0]\n",
        "        df_dec = df_cat[df_cat['mortality'] == 1]\n",
        "\n",
        "        prev_dis = (df_dis[col].mean() * 100) if len(df_dis) > 0 else 0\n",
        "        prev_dec = (df_dec[col].mean() * 100) if len(df_dec) > 0 else 0\n",
        "        diff = prev_dec - prev_dis\n",
        "\n",
        "        try:\n",
        "            contingency_table = pd.crosstab(df_cat['mortality'], df_cat[col])\n",
        "            chi2, pval, dof, expected = chi2_contingency(contingency_table)\n",
        "            sig_stars = '***' if pval < 0.001 else '**' if pval < 0.01 else '*' if pval < 0.05 else ''\n",
        "        except:\n",
        "            sig_stars = ''\n",
        "\n",
        "        row[format_name(col)] = f'{diff:+.1f}%{sig_stars}'\n",
        "\n",
