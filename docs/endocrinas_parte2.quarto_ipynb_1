      "source": [
        "# Función para clasificar enfermedades endocrinas\n",
        "def get_endocrine_category(diag_str):\n",
        "    \"\"\"Clasifica diagnóstico en categoría de enfermedad endocrina\"\"\"\n",
        "    if pd.isna(diag_str) or diag_str == '':\n",
        "        return None\n",
        "\n",
        "    diag = str(diag_str).strip().upper()[:3]\n",
        "\n",
        "    try:\n",
        "        num = int(diag[1:])\n",
        "        if 0 <= num <= 7:\n",
        "            return 'E00-E07: Thyroid'\n",
        "        elif 8 <= num <= 13:\n",
        "            return 'E08-E13: Diabetes'\n",
        "        elif 15 <= num <= 16:\n",
        "            return 'E15-E16: Glucose'\n",
        "        elif 20 <= num <= 35:\n",
        "            return 'E20-E35: Endocrine'\n",
        "        elif num == 36:\n",
        "            return 'E36: Intraoperative'\n",
        "        elif 40 <= num <= 46:\n",
        "            return 'E40-E46: Malnutrition'\n",
        "        elif 50 <= num <= 64:\n",
        "            return 'E50-E64: Nutritional'\n",
        "        elif 65 <= num <= 68:\n",
        "            return 'E65-E68: Obesity'\n",
        "        elif 70 <= num <= 88:\n",
        "            return 'E70-E88: Metabolic'\n",
        "        elif num == 89:\n",
        "            return 'E89: Postprocedural'\n",
        "    except:\n",
        "        pass\n",
        "\n",
        "    return None\n",
        "\n",
        "# Filtrar registros válidos\n",
        "# Remover sexo desconocido\n",
        "df_clean = df_grd[df_grd['SEXO'] != 'DESCONOCIDO'].copy()\n",
        "\n",
        "# Remover edades faltantes o inválidas\n",
        "df_clean = df_clean[(df_clean['age'].notna()) & (df_clean['age'] > 0) & (df_clean['age'] < 150)].copy()\n",
        "\n",
        "# Remover duración de estadía inválida\n",
        "df_clean = df_clean[(df_clean['length_of_stay'].notna()) & (df_clean['length_of_stay'] >= 0)].copy()"
      ],
      "id": "e6d8a109",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Filter for ENDOCRINE diseases (DIAGNOSTICO1 starting with E00-E89)\n",
        "def is_endocrine_diagnosis(diag):\n",
        "    \"\"\"Checks if diagnosis is an endocrine disease (E00-E89)\"\"\"\n",
        "    if pd.isna(diag) or diag == '':\n",
        "        return False\n",
        "\n",
        "    diag_str = str(diag).strip().upper()\n",
        "    if len(diag_str) < 1:\n",
        "        return False\n",
        "\n",
        "    icd_code = diag_str[:3]\n",
        "\n",
        "    if icd_code[0] == 'E':\n",
        "        try:\n",
        "            num = int(icd_code[1:])\n",
        "            return 0 <= num <= 89\n",
        "        except:\n",
        "            return False\n",
        "\n",
        "    return False\n",
        "\n",
        "# Apply filter\n",
        "df_endocrinas = df_clean[df_clean['DIAGNOSTICO1'].apply(is_endocrine_diagnosis)].copy()\n",
        "\n",
        "# Classify by category\n",
        "df_endocrinas['endocrine_category'] = df_endocrinas['DIAGNOSTICO1'].apply(get_endocrine_category)\n",
        "\n",
        "vc = df_endocrinas['endocrine_category'].value_counts().reset_index()\n",
        "vc.columns = ['Category', 'N']\n",
        "vc['%'] = (vc['N'] / vc['N'].sum() * 100).round(1)\n",
        "show_table(vc, \"Endocrine Disease Category Distribution\")"
      ],
      "id": "24ae652c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Detectar comorbilidades basadas en diagnósticos secundarios\n",
        "\n",
        "# Definir grupos de comorbilidades\n",
        "life_groups = {\n",
        "    \"obesity_overweight\": [\"E66\", \"E65\", \"E67\", \"E68\", \"R63\", \"Z68\"],\n",
        "    \"dyslipidemia_metabolic\": [\"E78\", \"E79\", \"E88\"],\n",
        "    \"diabetes_glucose\": [\"E10\", \"E11\", \"E12\", \"E13\", \"E14\", \"E09\", \"R73\", \"E08\"],\n",
        "    \"hypertension\": [\"I10\", \"I11\", \"I12\", \"I13\", \"I15\", \"I16\", \"I27\"],\n",
        "    \"tobacco_related\": [\"F17\", \"Z72\", \"Z87\", \"J44\", \"J43\", \"J41\", \"J42\", \"J47\", \"J40\", \"J98\"],\n",
        "    \"alcohol_related\": [\"F10\", \"K70\", \"K29\", \"G31\", \"G62\", \"G72\", \"I42\", \"K86\", \"E24\", \"E52\", \"T51\", \"Y90\", \"Y91\"],\n",
        "    \"substance_use\": [\"F11\", \"F12\", \"F13\", \"F14\", \"F15\", \"F16\", \"F18\", \"F19\", \"F55\"],\n",
        "    \"nutritional_deficiencies\": [\"E40\", \"E41\", \"E42\", \"E43\", \"E44\", \"E45\", \"E46\", \"E50\", \"E51\", \"E52\", \"E53\", \"E54\", \"E55\", \"E56\", \"E58\", \"E59\", \"E60\", \"E61\", \"E63\", \"E64\", \"D50\", \"D51\", \"D52\", \"D53\"],\n",
        "    \"liver_disease_nonalcoholic\": [\"K76\", \"K72\", \"K73\", \"K74\", \"K75\", \"K77\"],\n",
        "    \"sleep_disorders\": [\"G47\", \"F51\", \"G25\"],\n",
        "    \"cardiovascular\": [\"I20\", \"I21\", \"I22\", \"I23\", \"I24\", \"I25\", \"I50\", \"I51\", \"I64\", \"I65\", \"I66\", \"I67\", \"I70\", \"I73\", \"I77\", \"I78\"],\n",
        "    \"gastrointestinal\": [\"K21\", \"K22\", \"K25\", \"K26\", \"K27\", \"K28\", \"K29\", \"K30\", \"K31\", \"K58\", \"K59\", \"K90\", \"K91\", \"K92\"],\n",
        "    \"musculoskeletal\": [\"M79\", \"M81\", \"M80\", \"M85\", \"M62\", \"M25\", \"M54\"],\n",
        "    \"mental_health\": [\"F32\", \"F33\", \"F34\", \"F41\", \"F43\", \"F48\", \"F50\", \"F54\"]\n",
        "}\n",
        "\n",
        "def check_comorbidity_group(row, icd_prefixes):\n",
        "    \"\"\"Verifica si el paciente tiene algún diagnóstico en la lista de prefijos ICD\"\"\"\n",
        "    for i in range(2, 36):\n",
        "        col = f'DIAGNOSTICO{i}'\n",
        "        if col in row.index and pd.notna(row[col]):\n",
        "            diag = str(row[col]).strip().upper()[:3]\n",
        "            for prefix in icd_prefixes:\n",
        "                if diag.startswith(prefix):\n",
        "                    return 1\n",
        "    return 0\n",
        "\n",
        "# Identificar comorbilidades\n",
        "for group_name, icd_codes in life_groups.items():\n",
        "    df_endocrinas[f'comor_{group_name}'] = df_endocrinas.apply(\n",
        "        lambda row: check_comorbidity_group(row, icd_codes),\n",
        "        axis=1\n",
        "    )\n",
        "\n",
        "# Comorbidity statistics\n",
        "comor_cols = [col for col in df_endocrinas.columns if col.startswith('comor_')]\n",
        "comor_summary = df_endocrinas[comor_cols].sum()\n",
        "comor_summary.index = [col.replace('comor_', '') for col in comor_cols]\n",
        "comor_pct = 100 * comor_summary / len(df_endocrinas)\n",
        "\n",
        "# Display comorbidity prevalence\n",
        "comor_display = pd.DataFrame({\n",
        "    'Comorbidity': sorted(comor_summary.index),\n",
        "    'Count': [comor_summary[name] for name in sorted(comor_summary.index)],\n",
        "    'Percentage': [comor_pct[name] for name in sorted(comor_summary.index)]\n",
        "})\n",
        "comor_display.columns = [format_name(c) if c != 'Comorbidity' else c for c in comor_display.columns]\n",
        "show_table(comor_display, \"Comorbidity Prevalence Overview\")\n",
        "\n",
        "# Total comorbidity burden\n",
        "df_endocrinas['total_comorbidities'] = df_endocrinas[comor_cols].sum(axis=1)\n",
        "\n",
        "# Display comorbidity burden summary\n",
        "comorbidity_burden = pd.DataFrame({\n",
        "    'Metric': ['Mean', 'Median', 'Std Dev'],\n",
        "    'Value': [\n",
        "        f\"{df_endocrinas['total_comorbidities'].mean():.2f}\",\n",
        "        f\"{df_endocrinas['total_comorbidities'].median():.0f}\",\n",
        "        f\"{df_endocrinas['total_comorbidities'].std():.2f}\"\n",
        "    ]\n",
        "})\n",
        "show_table(comorbidity_burden, \"Comorbidity Burden Statistics\")"
      ],
      "id": "d80e00eb",
      "execution_count": null,
      "outputs": []
