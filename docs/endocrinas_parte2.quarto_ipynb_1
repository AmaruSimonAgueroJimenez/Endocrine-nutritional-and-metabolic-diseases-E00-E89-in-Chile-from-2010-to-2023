        "# Service categorization\n",
        "def categorize_service(service_name):\n",
        "    \"\"\"Categorizes services into ICU/ITU, Medical/Surgical (MS), Others\"\"\"\n",
        "    if pd.isna(service_name) or service_name == '':\n",
        "        return 'Other'\n",
        "\n",
        "    service = str(service_name).upper()\n",
        "\n",
        "    if any(x in service for x in ['UCI', 'UTI', 'ICU', 'CRÍTICO', 'INTENSIVO', 'PABELLON CRITICO']):\n",
        "        return 'ICU/ITU'\n",
        "    elif any(x in service for x in ['CIRUGIA', 'MEDICINA', 'GENERAL']):\n",
        "        return 'Medical/Surgical'\n",
        "    else:\n",
        "        return 'Other'\n",
        "\n",
        "df_endocrinas['service_category'] = df_endocrinas['SERVICIOINGRESO'].apply(categorize_service)\n",
        "\n",
        "vc_service = df_endocrinas['service_category'].value_counts().reset_index()\n",
        "vc_service.columns = ['Service', 'N']\n",
        "vc_service['%'] = (vc_service['N'] / vc_service['N'].sum() * 100).round(1)\n",
        "show_table(vc_service, \"Service Category Distribution\")\n",
