      "source": [
        "#| label: fig-endocrine-neoplasm-networks\n",
        "#| fig-cap: 'Network topology comparison: Endocrine+Neoplasm vs Endocrine-only patients'\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(18, 8))\n",
        "\n",
        "for idx, (group_name, G) in enumerate(networks_with_without.items()):\n",
        "    ax = axes[idx]\n",
        "\n",
        "    if G.number_of_nodes() == 0:\n",
        "        ax.text(0.5, 0.5, f'No data for {group_name}', ha='center', va='center')\n",
        "        continue\n",
        "\n",
        "    # Layout\n",
        "    pos = nx.circular_layout(G)\n",
        "    # Edge width proportional to Jaccard weight (strength) — circular layout, nodes NOT moved\n",
        "    _ew = [G[_u][_v].get('weight', 1.0) for _u, _v in G.edges()]\n",
        "    _wmin, _wmax = (min(_ew), max(_ew)) if _ew else (0.0, 1.0)\n",
        "    _ewidths = ([0.5 + 3.0 * (w - _wmin) / (_wmax - _wmin) for w in _ew]\n",
        "                if _wmax > _wmin else [1.5 for _ in _ew])\n",
        "\n",
        "    # Node properties\n",
        "    node_degrees = dict(G.degree())\n",
        "    node_sizes = [node_degrees.get(node, 1) * 120 for node in G.nodes()]\n",
        "    node_colors = [get_comorbidity_color(node) for node in G.nodes()]\n",
        "\n",
        "    # Draw\n",
        "    nx.draw_networkx_edges(G, pos, ax=ax, width=_ewidths, alpha=0.4, edge_color='gray')\n",
        "    nx.draw_networkx_nodes(G, pos, ax=ax, node_size=node_sizes,\n",
        "                          node_color=node_colors, alpha=0.8,\n",
        "                          edgecolors='black', linewidths=1)\n",
        "    # Labels rotated to each node's radial angle (perpendicular to the circle), placed just outside the node\n",
        "    _label_offset = 0.10\n",
        "    for _node, (_nx_x, _nx_y) in pos.items():\n",
        "        _r = np.hypot(_nx_x, _nx_y) or 1.0\n",
        "        _ang = np.degrees(np.arctan2(_nx_y, _nx_x))\n",
        "        _flip = _ang > 90 or _ang < -90\n",
        "        _rot = _ang + 180 if _flip else _ang\n",
        "        ax.text(_nx_x + (_nx_x / _r) * _label_offset,\n",
        "                _nx_y + (_nx_y / _r) * _label_offset,\n",
        "                _node, fontsize=8, fontweight='bold',\n",
        "                rotation=_rot, rotation_mode='anchor',\n",
        "                ha='right' if _flip else 'left', va='center', clip_on=False)\n",
        "    ax.set_aspect('equal')\n",
        "    ax.set_xlim(-2.1, 2.1)\n",
        "    ax.set_ylim(-2.0, 2.0)\n",
        "\n",
        "    ax.set_title(f'{group_name}\\n(Nodes: {G.number_of_nodes()}, Edges: {G.number_of_edges()})',\n",
