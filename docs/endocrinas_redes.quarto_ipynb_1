        "}\n",
        "\n",
        "# Create category-to-color mapping\n",
        "category_colors = {\n",
        "    'CV': '#E74C3C',    # Red\n",
        "    'MET': '#3498DB',   # Blue\n",
        "    'RESP': '#2ECC71',  # Green\n",
