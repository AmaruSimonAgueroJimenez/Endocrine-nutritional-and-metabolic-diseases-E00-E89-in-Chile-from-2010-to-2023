      "source": [
        "#| output: false\n",
        "#| label: neoplastic-analysis\n",
        "\n",
        "# Define neoplastic comorbidity codes\n",
        "neoplastic_codes = {\n",
        "    'C15': 'Esophageal',\n",
        "    'C16': 'Gastric',\n",
        "    'C18': 'Colon',\n",
        "    'C19': 'Rectosigmoid',\n",
        "    'C20': 'Rectum',\n",
        "    'C21': 'Anus',\n",
        "    'C22': 'Liver',\n",
        "    'C23': 'Gallbladder',\n",
        "    'C25': 'Pancreas',\n",
        "    'C26': 'Other digestive',\n",
        "}\n",
        "\n",
        "def has_neoplasm(row):\n",
        "    \"\"\"Check if patient has any neoplasm diagnosis.\"\"\"\n",
        "    for i in range(1, 36):\n",
        "        diag_col = f'DIAGNOSTICO{i}'\n",
        "        if diag_col not in row.index:\n",
        "            continue\n",
        "\n",
        "        diag_code = normalize_icd_code(row[diag_col])\n",
        "        if diag_code is None:\n",
        "            continue\n",
        "\n",
        "        # Check against neoplasm codes\n",
        "        for neopl_code in neoplastic_codes.keys():\n",
        "            if diag_code.startswith(neopl_code):\n",
        "                return True\n",
        "\n",
        "    return False\n",
        "\n",
        "# Add neoplasm indicator\n",
        "grd_endocrine['HAS_NEOPLASM'] = grd_endocrine.apply(has_neoplasm, axis=1)\n",
        "\n",
        "# Calculate neoplastic comorbidity prevalence by year\n",
        "neoplastic_prevalence = []\n",
        "\n",
        "for year in sorted(grd_endocrine['YEAR'].unique()):\n",
        "    year_data = grd_endocrine[grd_endocrine['YEAR'] == year]\n",
        "    total = len(year_data)\n",
        "    with_neoplasm = year_data['HAS_NEOPLASM'].sum()\n",
        "    prevalence = with_neoplasm / total * 100 if total > 0 else 0\n",
        "\n",
        "    neoplastic_prevalence.append({\n",
        "        'Year': year,\n",
        "        'Total_Patients': total,\n",
        "        'With_Neoplasm': with_neoplasm,\n",
        "        'Neoplasm_Prevalence_%': prevalence,\n",
        "    })\n",
        "\n",
        "neoplastic_prev_df = pd.DataFrame(neoplastic_prevalence)\n",
        "print(\"Neoplastic Disease Comorbidity Prevalence:\")\n",
        "print(neoplastic_prev_df.to_string(index=False))"
