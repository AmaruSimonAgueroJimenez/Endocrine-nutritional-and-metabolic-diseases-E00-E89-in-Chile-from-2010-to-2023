      "source": [
        "#| output: false\n",
        "#| label: edge-evolution\n",
        "\n",
        "# Identify top co-occurrence pairs across all years\n",
        "top_pairs = []\n",
        "all_pairs_across_years = defaultdict(list)\n",
        "\n",
        "for year in sorted(cooccurrence_per_year.keys()):\n",
        "    cooccurrence = cooccurrence_per_year[year]\n",
        "    for (source, target), weight in cooccurrence.items():\n",
        "        all_pairs_across_years[(source, target)].append((year, weight))\n",
        "\n",
        "# Calculate average weight per pair across all years\n",
        "pair_avg_weights = {\n",
        "    pair: np.mean([w for _, w in years_weights])\n",
        "    for pair, years_weights in all_pairs_across_years.items()\n",
        "}\n",
        "\n",
        "# Get top 10 pairs\n",
        "top_10_sorted = sorted(pair_avg_weights.items(), key=lambda x: x[1], reverse=True)[:10]\n",
        "top_10_pairs = [pair for pair, _ in top_10_sorted]\n",
        "\n",
        "# Create evolution data\n",
        "edge_evolution_data = []\n",
        "for pair in top_10_pairs:\n",
        "    for year, weight in all_pairs_across_years[pair]:\n",
        "        edge_evolution_data.append({\n",
        "            'Pair': f\"{pair[0]} ↔ {pair[1]}\",\n",
        "            'Year': year,\n",
        "            'Weight': weight,\n",
        "        })\n",
        "\n",
        "edge_evolution_df = pd.DataFrame(edge_evolution_data)\n",
        "print(\"Top 10 Co-occurrence Pairs (by average weight):\")\n",
        "for pair, avg_weight in top_10_sorted:\n",
        "    print(f\"  {pair[0]} ↔ {pair[1]}: {avg_weight:.2f}\")"
