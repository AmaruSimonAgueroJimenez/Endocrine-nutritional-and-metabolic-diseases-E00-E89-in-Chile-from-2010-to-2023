        "\n",
        "        edge_changes.append({\n",
        "            'Pair': f\"{pair[0]} ↔ {pair[1]}\",\n",
        "            '2019': years_weights[2019],\n",
        "            '2024': years_weights[2024],\n",
        "            'Change': change,\n",
        "            'Pct_Change': pct_change,\n",
